{
  "name": "portfolio-v2",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "astro": "astro",
    "lint": "eslint . --ext .js,.ts,.tsx,.astro",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,astro,css,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,astro,css,md,json,yml,yaml}\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "7.0.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.0",
    "wrangler": "^4.103.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
