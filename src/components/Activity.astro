---
import { env } from 'cloudflare:workers';

// On Cloudflare, secrets come from the worker runtime; fall back to `import.meta.env` for local `astro dev`.
const token = env.GITHUB_TOKEN ?? import.meta.env.GITHUB_TOKEN;
const username = env.GITHUB_USERNAME ?? import.meta.env.GITHUB_USERNAME;

interface GraphQLResponse {
  data?: {
    user: {
      contributionsCollection: {
        contributionCalendar: {
          totalContributions: number;
          weeks: {
            contributionDays: {
              date: string;
              contributionCount: number;
              contributionLevel: string;
            }[];
          }[];
        };
      };
    };
  };
}

interface Day {
  date: string;
  count: number;
  level: string;
}

const MONTH_LABELS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const DAY_LABELS = ['', 'Mon', '', 'Wed', '', 'Fri', '']; // Sun -> Sat

// GitHub's dark-theme contribution palette, keyed by contributionLevel.
const LEVEL_COLORS: Record<string, string> = {
  NONE: '#161b22',
  FIRST_QUARTILE: '#0e4429',
  SECOND_QUARTILE: '#006d32',
  THIRD_QUARTILE: '#26a641',
  FOURTH_QUARTILE: '#39d353',
};

const CELL = 11; // px square
const GAP = 3; // px between cells
const DAY_LABEL_W = 26; // px width reserved for the Mon/Wed/Fri column

let totalContributions = 0;
let weeks: (Day | null)[][] = [];

if (!token || !username) {
  console.error('GitHub activity: missing GITHUB_TOKEN or GITHUB_USERNAME at runtime.');
}

if (token && username) {
  try {
    const res = await fetch('https://api.github.com/graphql', {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${token}`,
        'Content-Type': 'application/json',
        // GitHub's API 403s without a User-Agent, and Workers' fetch doesn't add one.
        'User-Agent': username,
      },
      body: JSON.stringify({
        query: `query ($userName: String!) {
          user(login: $userName) {
            contributionsCollection {
              contributionCalendar {
                totalContributions
                weeks {
                  contributionDays {
                    date
                    contributionCount
                    contributionLevel
                  }
                }
              }
            }
          }
        }`,
        variables: { userName: username },
      }),
    });

    if (!res.ok) {
      console.error('GitHub activity: request failed', res.status, await res.text());
    } else {
      const json = (await res.json()) as GraphQLResponse;
      if (json.data?.user) {
        const calendar = json.data.user.contributionsCollection.contributionCalendar;
        totalContributions = calendar.totalContributions;
        // Pad each week to 7 weekday slots (Sun..Sat) so partial first/last weeks align.
        weeks = calendar.weeks.map((week) => {
          const slots: (Day | null)[] = Array(7).fill(null);
          for (const day of week.contributionDays) {
            const weekday = new Date(day.date + 'T00:00:00').getDay();
            slots[weekday] = { date: day.date, count: day.contributionCount, level: day.contributionLevel };
          }
          return slots;
        });
      } else {
        console.error('GitHub activity: unexpected response', JSON.stringify(json));
      }
    }
  } catch (error) {
    console.error('Error fetching GitHub data:', error);
  }
}

// One label per week where the month changes, positioned over that week's column.
const monthLabels: { index: number; label: string }[] = [];
let lastMonth = -1;
weeks.forEach((week, i) => {
  const firstDay = week.find((day) => day !== null);
  if (!firstDay) return;
  const month = new Date(firstDay.date + 'T00:00:00').getMonth();
  if (month !== lastMonth) {
    monthLabels.push({ index: i, label: MONTH_LABELS[month] });
    lastMonth = month;
  }
});

const hasData = weeks.length > 0;
---

{
  hasData && (
    <section id='activity-container'>
      <dl>
        <dt class='dt-entry'>
          <h3 class='text-zinc-400'>Activity</h3>
        </dt>
        <dd class='dd-entry'>
          <div class='flex flex-col gap-3'>
            <p>{totalContributions.toLocaleString()} contributions in the last year</p>
            <div class='overflow-x-auto pb-1'>
              <div class='inline-block'>
                <div class='relative h-4' style={`margin-left: ${DAY_LABEL_W}px`}>
                  {monthLabels.map(({ index, label }) => (
                    <span class='absolute top-0 text-[10px] text-zinc-500' style={`left: ${index * (CELL + GAP)}px`}>
                      {label}
                    </span>
                  ))}
                </div>
                <div class='flex' style={`gap: ${GAP}px`}>
                  <div class='flex flex-col' style={`gap: ${GAP}px; width: ${DAY_LABEL_W}px`}>
                    {DAY_LABELS.map((label) => (
                      <span class='flex items-center text-[10px] leading-none text-zinc-500' style={`height: ${CELL}px`}>
                        {label}
                      </span>
                    ))}
                  </div>
                  {weeks.map((week) => (
                    <div class='flex flex-col' style={`gap: ${GAP}px`}>
                      {week.map((day) => (
                        <div
                          class='rounded-[2px] transition-[filter] duration-150 hover:brightness-150'
                          style={`width: ${CELL}px; height: ${CELL}px; background-color: ${day ? (LEVEL_COLORS[day.level] ?? LEVEL_COLORS.NONE) : LEVEL_COLORS.NONE}`}
                          title={day ? `${day.count} contribution${day.count === 1 ? '' : 's'} on ${day.date}` : undefined}
                        />
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </dd>
      </dl>
    </section>
  )
}
