---
import Badge from '@/components/ui/Badge.astro';
---

<section id='experience-container'>
  <dl>
    <dt class='dt-entry'>
      <h3 class='flex items-center gap-1 text-zinc-400'>
        Jun 2025 <Badge class='ml-0.5'>Present</Badge>
      </h3>
    </dt>
    <dd class='dd-entry pt-0 sm:pt-4'>
      <p>
        Founding Software Engineer @ <a
          href='https://superpower.com'
          class='inline-flex hover:text-orange-500 transition-colors duration-250 ease-in-out'
        >
          Superpower</a
        >
      </p>
      <p class='caption pt-1'>Remotely (San Francisco, CA HQ)</p>
    </dd>
    <dt class='dt-entry-subsequent'>
      <h3 class='text-zinc-400'>Feb 2022 - Jun 2025</h3>
    </dt>
    <dd class='dd-entry-subsequent'>
      <p>
        Front-End Engineer @ <a
          href='https://anatomize.tech'
          class='inline-flex hover:text-[#2F65FD] transition-colors duration-250 ease-in-out'
        >
          Anatomize</a
        >
      </p>
      <p class='caption pt-1'>Remotely (Miami Beach, FL HQ)</p>
    </dd>
  </dl>
</section>
