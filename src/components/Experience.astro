---
import Badge from '../ui/Badge.astro';
---

<section>
  <dl>
    <dt class='dt-entry'>
      <h3 class='flex items-center gap-1 text-zinc-500'>
        Jun 2025 <Badge class='ml-0.5'>Present</Badge>
      </h3>
    </dt>
    <dd class='dd-entry pt-0 sm:pt-4'>
      <p>Founding Software Engineer</p>
      <a
        href='https://superpower.com'
        class='inline-flex items-center gap-1 hover:text-orange-500 transition-colors duration-250 ease-in-out'
        >Superpower
      </a>
      <p class='caption'>Remotely (San Francisco, CA HQ)</p>
    </dd>
    <dt class='dt-entry-subsequent'>
      <h3 class='text-tertiary'>Feb 2022</h3>
    </dt>
    <dd class='dd-entry-subsequent'>
      <p>Front-End Engineer</p>
      <a
        href='https://anatomize.tech'
        class='inline-flex items-center gap-1 hover:text-[#2F65FD] transition-colors duration-250 ease-in-out'
        >Anatomize</a
      >
      <p class='caption'>Remotely (Miami Beach, FL HQ)</p>
    </dd>
  </dl>
</section>
