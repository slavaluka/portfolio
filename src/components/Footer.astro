---
import TwitterIcon from './icons/Twitter.astro';
import GitHubIcon from './icons/GitHub.astro';

const socialLinks = [
  {
    href: 'https://x.com/slavalukianchuk',
    icon: TwitterIcon,
  },
  {
    href: 'https://github.com/slavaluka',
    icon: GitHubIcon,
  },
];
---

<section id='footer-container'>
  <footer class='m:px-0 flex w-full justify-center'>
    <div class='max-w-main flex-1'>
      <div
        class='flex h-full w-full items-end justify-between border-t border-solid border-neutral-500/10 pt-8 dark:border-neutral-900'
      >
        <div class='flex gap-3'>
          {
            socialLinks.map((link) => (
              <a
                class='flex items-center gap-1.5 hover:opacity-80 transition duration-250 ease-in-out'
                href={link.href}
                target='_blank'
                rel='noopener noreferrer'
              >
                <link.icon />
              </a>
            ))
          }
        </div>
        <div
          class='flex h-full flex-col items-end justify-end sm:justify-between'
        >
          <div
            class='flex-1 select-none text-xs text-neutral-900/30 dark:text-neutral-700 block'
            aria-hidden='true'
            role='img'
          >
            52°13&prime;47&Prime; N 21°00&prime;44&Prime; E
          </div>
        </div>
      </div>
    </div>
  </footer>
</section>
