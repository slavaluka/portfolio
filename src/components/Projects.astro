---
import amorusIcon from '@/assets/projects/amorus-ios-icon.webp';
import ppIcon from '@/assets/projects/pp-ios-icon.webp';
import raenaIcon from '@/assets/projects/raena-ios-icon.webp';
import superpowerIcon from '@/assets/projects/superpower-ios-icon.webp';
import { Image } from 'astro:assets';
---

<section id='projects-container'>
  <dl>
    <dt class='dt-entry'>
      <h3 class='text-zinc-400'>Projects</h3>
    </dt>
    <dd class='dd-entry'>
      <a
        href='https://apps.apple.com/us/app/superpower/id6747997159'
        class='flex items-center gap-3 sm:gap-4 no-underline group hover:opacity-75 transition duration-250 ease-in-out'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Superpower website'
      >
        <Image
          src={superpowerIcon}
          alt='Superpower'
          width={40}
          height={40}
          densities={[1.5, 2]}
          class='rounded-lg w-10 h-10 pointer-events-none group-hover:-rotate-12 transition duration-250 ease-in-out'
          format='webp'
          loading='eager'
        />
        <div class='space-y-0.5'>
          <p class='flex items-center gap-1.5'>Superpower</p>
          <p class='caption'>
            An ecosystem of diagnostic tools and clinician-trusted solutions, personalized to individual patient needs (100+ biomarkers, AI
            insights, concierge care).
          </p>
        </div>
      </a>
      <br />
      <a
        href='https://premiumpeptides.com/'
        class='flex items-center gap-3 sm:gap-4 no-underline group hover:opacity-75 transition duration-250 ease-in-out'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Premium Peptides website'
      >
        <Image
          src={ppIcon}
          alt='Premium Peptides'
          width={40}
          height={40}
          densities={[1.5, 2]}
          class='rounded-lg w-10 h-10 pointer-events-none group-hover:-rotate-12 transition duration-250 ease-in-out'
          format='webp'
          loading='eager'
        />
        <div class='space-y-0.5'>
          <p>Premium Peptides</p>
          <p class='caption'>
            A performance-focused ecommerce platform for research-grade peptides, with integrated payments, real-time inventory, and
            lab-verified product catalog.
          </p>
        </div>
      </a>
      <br />
      <a
        href='https://apps.apple.com/vn/app/raena-health/id6766805317'
        class='flex items-center gap-3 sm:gap-4 no-underline group hover:opacity-75 transition duration-250 ease-in-out'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Raena website'
      >
        <Image
          src={raenaIcon}
          alt='Raena'
          width={40}
          height={40}
          densities={[1.5, 2]}
          class='rounded-lg w-10 h-10 pointer-events-none group-hover:-rotate-12 transition duration-250 ease-in-out'
          format='webp'
          loading='eager'
        />
        <div class='space-y-0.5'>
          <p>Raena</p>
          <p class='caption'>A hormone and cycle tracker that puts test results, ovulation, and month-to-month patterns in one place.</p>
        </div>
      </a>
      <br />
      <a
        href='https://apps.apple.com/ie/app/amorus-couple-sexy-games-date/id1556508195'
        class='flex items-center gap-3 sm:gap-4 no-underline group hover:opacity-75 transition duration-250 ease-in-out'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Amorus website'
      >
        <Image
          src={amorusIcon}
          alt='Amorus'
          width={40}
          height={40}
          densities={[1.5, 2]}
          class='rounded-lg w-10 h-10 pointer-events-none group-hover:-rotate-12 transition duration-250 ease-in-out'
          format='webp'
          loading='eager'
        />
        <div class='space-y-0.5'>
          <p>Amorus</p>
          <p class='caption'>
            A private, secure gaming and messaging platform designed to enhance intimacy and connection between consenting partners.
          </p>
        </div>
      </a>
    </dd>
  </dl>
</section>
