---
import amorusIcon from '@/assets/projects/amorus-ios-icon.webp';
import ppIcon from '@/assets/projects/pp-ios-icon.webp';
import roadsiderIcon from '@/assets/projects/roadsider-ios-icon.webp';
import superpowerIcon from '@/assets/projects/superpower-ios-icon.webp';
import { Image } from 'astro:assets';
---

<section id='projects-container'>
  <dl>
    <dt class='dt-entry'>
      <h3 class='text-zinc-400'>Projects</h3>
    </dt>
    <dd class='dd-entry'>
      <a
        href='https://apps.apple.com/us/app/superpower/id6747997159'
        class='flex items-center gap-3 sm:gap-4 no-underline group hover:opacity-75 transition duration-250 ease-in-out'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Superpower website'
      >
        <Image
          src={superpowerIcon}
          alt='Superpower'
          width={40}
          height={40}
          densities={[1.5, 2]}
          class='rounded-lg w-10 h-10 pointer-events-none group-hover:-rotate-12 transition duration-250 ease-in-out'
          format='webp'
          loading='eager'
        />
        <div class='space-y-0.5'>
          <p class='flex items-center gap-1.5'>
            Superpower
            <svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' aria-hidden='true'>
              <rect width='24' height='24' fill='#F0652F'></rect>
              <path
                fill='#fff'
                d='M6.951 5.896l4.112 7.708v5.064h1.583v-4.972l4.148-7.799h-1.749l-2.457 4.875c-.372.745-.688 1.434-.688 1.434s-.297-.708-.651-1.434L8.831 5.896z'
              ></path>
            </svg>
          </p>
          <p class='caption'>
            A YC-backed Series A startup offering an ecosystem of diagnostic tools and clinician-trusted solutions, personalized to
            individual patient needs.
          </p>
        </div>
      </a>
      <br />
      <a
        href='https://premium-peptides-frontend.pages.dev'
        class='flex items-center gap-3 sm:gap-4 no-underline group hover:opacity-75 transition duration-250 ease-in-out'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Premium Peptides website'
      >
        <Image
          src={ppIcon}
          alt='Premium Peptides'
          width={40}
          height={40}
          densities={[1.5, 2]}
          class='rounded-lg w-10 h-10 pointer-events-none group-hover:-rotate-12 transition duration-250 ease-in-out'
          format='webp'
          loading='eager'
        />
        <div class='space-y-0.5'>
          <p>Premium Peptides</p>
          <p class='caption'>
            A performance-focused ecommerce platform for research-grade peptides, with integrated payments, real-time inventory, and
            lab-verified product catalog.
          </p>
        </div>
      </a>
      <br />
      <a
        href='https://apps.apple.com/ie/app/amorus-couple-sexy-games-date/id1556508195'
        class='flex items-center gap-3 sm:gap-4 no-underline group hover:opacity-75 transition duration-250 ease-in-out'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Amorus website'
      >
        <Image
          src={amorusIcon}
          alt='Amorus'
          width={40}
          height={40}
          densities={[1.5, 2]}
          class='rounded-lg w-10 h-10 pointer-events-none group-hover:-rotate-12 transition duration-250 ease-in-out'
          format='webp'
          loading='eager'
        />
        <div class='space-y-0.5'>
          <p>Amorus</p>
          <p class='caption'>
            A private, secure gaming and messaging platform designed to enhance intimacy and connection between consenting partners.
          </p>
        </div>
      </a>
      <br />
      <a
        href='https://apps.apple.com/ie/app/roadsider-tools/id1564257240'
        class='flex items-center gap-3 sm:gap-4 no-underline group hover:opacity-75 transition duration-250 ease-in-out'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Roadsider website'
      >
        <Image
          src={roadsiderIcon}
          alt='Roadsider'
          width={40}
          height={40}
          densities={[1.5, 2]}
          class='rounded-lg w-10 h-10 pointer-events-none group-hover:-rotate-12 transition duration-250 ease-in-out'
          format='webp'
          loading='eager'
        />
        <div class='space-y-0.5'>
          <p>Roadsider</p>
          <p class='caption'>
            A highly automated, end-to-end roadside assistance platform built for speed, scale, and operational efficiency.
          </p>
        </div>
      </a>
    </dd>
  </dl>
</section>
