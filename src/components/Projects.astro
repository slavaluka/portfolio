---
import { Image } from 'astro:assets';
import Badge from './ui/Badge.astro';
import superpowerIcon from '../assets/projects/superpower-ios-icon.webp';
import amorusIcon from '../assets/projects/amorus-ios-icon.webp';
import roadsiderIcon from '../assets/projects/roadsider-ios-icon.webp';
---

<section id='projects-container'>
  <dl>
    <dt class='dt-entry'>
      <h3 class='text-tertiary'>Projects</h3>
    </dt>
    <dd class='dd-entry'>
      <div class='relative group'>
        <div
          class='flex items-center gap-3 sm:gap-4 transition duration-320 group-hover:blur-sm translate-z-0 cursor-pointer'
        >
          <Image
            src={superpowerIcon}
            alt='Superpower'
            width={40}
            height={40}
            densities={[1.5, 2]}
            class='rounded-lg w-10 h-10 pointer-events-none'
            format='webp'
            loading='eager'
          />
          <div class='space-y-0.5'>
            <p>
              Superpower <Badge class='ml-0.5'>iOS</Badge>
            </p>
            <p class='caption'>
              An ecosystem of diagnostic tools and clinician-trusted solutions,
              personalized to individual patient needs.
            </p>
          </div>
        </div>
        <div
          class='hidden pointer-events-none absolute inset-0 md:flex items-center justify-center opacity-0 translate-y-4 group-hover:opacity-100 transition duration-250 group-hover:translate-y-0'
        >
          <span
            class='text-sm text-gray-400 bg-white/10 px-4 py-2 rounded-full'
          >
            Coming Soon
          </span>
        </div>
      </div>
      <br />
      <a
        href='https://apps.apple.com/ie/app/amorus-couple-sexy-games-date/id1556508195'
        class='flex items-center gap-3 sm:gap-4 no-underline group hover:opacity-75 transition duration-250 ease-in-out'
        target='_blank'
        rel='noopener noreferrer'
      >
        <Image
          src={amorusIcon}
          alt='Amorus'
          width={40}
          height={40}
          densities={[1.5, 2]}
          class='rounded-lg w-10 h-10 pointer-events-none'
          format='webp'
          loading='eager'
        />
        <div class='space-y-0.5'>
          <p>Amorus</p>
          <p class='caption'>
            A private, secure gaming and messaging platform designed to enhance
            intimacy and connection between consenting partners.
          </p>
        </div>
      </a>
      <br />
      <a
        href='https://apps.apple.com/ie/app/roadsider-tools/id1564257240'
        class='flex items-center gap-3 sm:gap-4 no-underline group hover:opacity-75 transition duration-250 ease-in-out'
        target='_blank'
        rel='noopener noreferrer'
      >
        <Image
          src={roadsiderIcon}
          alt='Roadsider'
          width={40}
          height={40}
          densities={[1.5, 2]}
          class='rounded-lg w-10 h-10 pointer-events-none'
          format='webp'
          loading='eager'
        />
        <div class='space-y-0.5'>
          <p>Roadsider</p>
          <p class='caption'>
            A highly automated, end-to-end roadside assistance platform built
            for speed, scale, and operational efficiency.
          </p>
        </div>
      </a>
    </dd>
  </dl>
</section>
