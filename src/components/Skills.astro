---
import Badge from '@/components/ui/Badge.astro';

const skills = ['Go', 'TypeScript', 'React', 'Node.js', 'PostgreSQL', 'Expo'];
---

<section id='skills-container'>
  <dl>
    <dt class='dt-entry'><h3 class='text-zinc-400'>Skills</h3></dt>
    <dd class='dd-entry'>
      <ul class='flex flex-wrap gap-1.5'>
        {
          skills.map((skill) => (
            <li>
              <Badge>{skill}</Badge>
            </li>
          ))
        }
      </ul>
    </dd>
  </dl>
</section>
